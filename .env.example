# The supplied Federato integration API. This is part of the core challenge,
# not an optional enrichment API.
FEDERATO_API_URL=https://product.federato.ai/integrations-api/handlers/federato-hack-north?outputOnly=true
FEDERATO_AUTH_URL=https://auth.product.federato.ai/oauth/token
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=

# The PDFs name the correct Auth0 domain but do not print the audience value.
# Copy the audience from Federato's API Documentation/organizer credentials.
FEDERATO_AUDIENCE=

# Keep true until credentials and the exact Query Request Body are available.
FEDERATO_USE_DEMO_DATA=true

# Temporary integration seam. Paste only the inner `payload` object accepted by
# { "action": "query", "payload": { ... } }. The data team should replace this
# with the schema-driven query planner before the MVP is considered complete.
FEDERATO_QUERY_PAYLOAD_JSON=

# Optional mapping from canonical fields to dot-separated response paths.
# Example: {"accountName":"account.name","primaryRiskState":"locations.0.state"}
FEDERATO_FIELD_MAP_JSON=
