# The supplied Federato integration API. This is part of the core challenge,
# not an optional enrichment API.
FEDERATO_API_URL=https://product.federato.ai/integrations-api/handlers/federato-hack-north?outputOnly=true
FEDERATO_AUTH_URL=https://auth.product.federato.ai/oauth/token
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=

# The PDFs name the correct Auth0 domain but do not print the audience value.
# Copy the audience from Federato's API Documentation/organizer credentials.
FEDERATO_AUDIENCE=

# Keep true until credentials and the exact Query Request Body are available.
FEDERATO_USE_DEMO_DATA=true

# Queries are now compiled from the discovered schema at runtime, so the
# FEDERATO_QUERY_PAYLOAD_JSON and FEDERATO_FIELD_MAP_JSON seams are gone.

# Optional planner model. With a key set, the planner asks the model which
# discovered field answers each appetite requirement; every path it picks is
# re-resolved against the schema before use. Without a key the planner falls
# back to schema name matching and the pipeline behaves identically otherwise.
#
# Put real keys in .env.local, which git ignores. Never in this file.
# Whichever key is present is used; set FEDERATO_PLANNER_PROVIDER to force one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FEDERATO_PLANNER_PROVIDER=
# Defaults: gpt-5.6-sol (openai), claude-opus-5 (anthropic).
FEDERATO_PLANNER_MODEL=gpt-4o-mini
FEDERATO_DISABLE_LLM_PLANNER=false
